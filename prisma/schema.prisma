// Prisma schema for the V1 persistence foundation.
//
// Scope (see docs/architecture/modules/10-v1-execution-plan.md, Phase 4):
// - proposals
// - runs
// - run steps / checkpoints
// - reviewer results
// - override audits
// - synthetic commits
// - capability discovery snapshots
// - derived rebuild jobs
//
// Canonical state itself (books/volumes/characters/...) lives in the
// filesystem-backed canonical workspace (see src/domain) and is NOT
// duplicated here. This schema only persists the runtime/audit layer that
// sits on top of that canonical workspace: proposals, run execution state,
// review/override history, synthetic commit bookkeeping, capability
// discovery snapshots, and derived (rebuildable) index jobs.
//
// Enum string values intentionally mirror src/domain/values.ts so that
// application code can validate/round-trip through the shared zod schemas
// instead of re-deriving a second source of truth here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Accepted command envelope records are persisted separately from run execution
// state so idempotency survives process restarts.
model Command {
  id             String   @id @default(uuid())
  commandId      String   @unique
  runId          String   @unique
  workspaceId    String
  bookId         String
  idempotencyKey String
  status         String
  acceptedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@index([runId])
  @@map("commands")
}

// ---------------------------------------------------------------------------
// Proposals
// ---------------------------------------------------------------------------

model Proposal {
  id                      String   @id @default(uuid())
  proposalId              String   @unique
  workspaceId             String
  bookId                  String
  artifactType            String
  targetId                String
  status                  String
  intent                  String
  basedOnCanonicalVersion String
  entityVersionRefs       Json?
  parentRunId             String
  supersedesProposalId    String?
  latestReviewResultId    String?
  overrideAuditId         String?
  bundledDiffRefs         Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  run             Run              @relation(fields: [parentRunId], references: [runId])
  canonicalDraft  ProposalDraft?
  reviewerResults ReviewerResult[]
  overrideAudits  OverrideAudit[]

  @@index([workspaceId, bookId])
  @@index([targetId])
  @@index([status])
  @@map("proposals")
}

model ProposalDraft {
  id           String   @id @default(uuid())
  proposalId   String   @unique
  relativePath String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [proposalId], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_drafts")
}

// ---------------------------------------------------------------------------
// Runs
// ---------------------------------------------------------------------------

model Run {
  id                      String    @id @default(uuid())
  runId                   String    @unique
  workspaceId             String
  bookId                  String
  commandIntent           String
  artifactType            String?
  targetId                String?
  status                  String
  nextExpectedState       String?
  requestedBy             String
  idempotencyKey          String
  basedOnCanonicalVersion String?
  driftReason             String?
  startedAt               DateTime  @default(now())
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  steps          RunStep[]
  proposals      Proposal[]
  overrideAudits OverrideAudit[]
  rebuildJobs    DerivedRebuildJob[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, bookId])
  @@index([status])
  @@map("runs")
}

// ---------------------------------------------------------------------------
// Run steps / checkpoints
// ---------------------------------------------------------------------------

model RunStep {
  id           String    @id @default(uuid())
  runId        String
  stepKey      String
  sequence     Int
  status       String
  isCheckpoint Boolean   @default(false)
  input        Json?
  output       Json?
  errorReason  String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  run Run @relation(fields: [runId], references: [runId])

  @@unique([runId, sequence])
  @@index([runId, stepKey])
  @@map("run_steps")
}

// ---------------------------------------------------------------------------
// Reviewer results
// ---------------------------------------------------------------------------

model ReviewerResult {
  id                String   @id @default(uuid())
  reviewResultId    String   @unique
  proposalId        String
  approved          Boolean
  hardFailures      Json
  dimensionScores   Json
  totalScore        Int
  rewriteDirectives Json
  overrideEligible  Boolean
  createdAt         DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [proposalId])

  @@index([proposalId])
  @@map("reviewer_results")
}

// ---------------------------------------------------------------------------
// Override audits
// ---------------------------------------------------------------------------

model OverrideAudit {
  id              String   @id @default(uuid())
  overrideAuditId String   @unique
  proposalId      String
  overrideReason  String
  overrideBy      String
  relatedRunId    String
  failedChecks    Json
  scoreSnapshot   Json
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [proposalId])
  run      Run      @relation(fields: [relatedRunId], references: [runId])

  @@index([proposalId])
  @@index([relatedRunId])
  @@map("override_audits")
}

// ---------------------------------------------------------------------------
// Synthetic commits
// ---------------------------------------------------------------------------

model SyntheticCommit {
  id                String   @id @default(uuid())
  syntheticCommitId String   @unique
  workspaceId       String
  bookId            String
  targetFilePaths   Json
  aggregatedFrom    Json?
  canonicalVersion  String
  message           String
  createdAt         DateTime @default(now())

  @@index([workspaceId, bookId])
  @@map("synthetic_commits")
}

// ---------------------------------------------------------------------------
// Capability discovery snapshots
// ---------------------------------------------------------------------------

model CapabilityDiscoverySnapshot {
  id           String   @id @default(uuid())
  snapshotId   String   @unique
  workspaceId  String
  status       String
  capabilityId String?
  source       String?
  details      String?
  discoveredAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([workspaceId])
  @@index([status])
  @@map("capability_discovery_snapshots")
}

// ---------------------------------------------------------------------------
// Derived rebuild jobs (graph/search/embedding reindex — always rebuildable,
// never a source of truth)
// ---------------------------------------------------------------------------

model DerivedRebuildJob {
  id          String    @id @default(uuid())
  jobId       String    @unique
  workspaceId String
  bookId      String?
  jobType     String
  status      String
  triggeredBy String?
  runId       String?
  errorReason String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  run Run? @relation(fields: [runId], references: [runId])

  @@index([workspaceId, bookId])
  @@index([status])
  @@map("derived_rebuild_jobs")
}

// ---------------------------------------------------------------------------
// Search documents (summary-layer embedding index, §8.4)
//
// Only summary-shaped text is stored here — never full manuscript body text.
// The `embedding` column uses pgvector's `vector(1536)` type (OpenAI
// text-embedding-3-small dimension). The Prisma-unsupported vector column is
// managed by the custom migration `enable_pgvector_and_search_documents`
// rather than a generated migration. Prisma-visible columns (text, contentHash,
// embedded flag) are used for cache-invalidation and incremental re-embedding
// without requiring Prisma to know about the vector column itself.
// ---------------------------------------------------------------------------

model SearchDocument {
  id          String   @id @default(uuid())
  documentId  String   @unique
  workspaceId String
  bookId      String
  nodeId      String
  kind        String
  sourceRef   String
  text        String
  contentHash String
  /// Set to true after the out-of-process embedding job populates the
  /// pgvector `embedding` column (managed via raw SQL, not Prisma).
  embedded    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, bookId])
  @@index([nodeId])
  @@index([contentHash])
  @@map("search_documents")
}

// ---------------------------------------------------------------------------
// Bootstrap sessions (§11.6)
//
// BootstrapSession models the recoverable onboarding flow for new projects.
// Captures status transitions, revision snapshots, and evidence trails.
// Sessions are abandoned after 30 days if incomplete.
// ---------------------------------------------------------------------------

model BootstrapSession {
  id                 String   @id @default(uuid())
  sessionId          String   @unique
  workspaceId        String
  bookId             String?  // Only set after first canonical commit
  status             String   // drafting, awaiting-approval, advancing, import-review, ready-to-write, completed, abandoned, failed
  stage              String   // current stage per 11.3 or 11.4 flow
  path               String   // new-book or import
  currentRevisionId   String?
  bookName           String?
  sessionType        String?
  completedAt        DateTime?
  abandonedAt        DateTime?
  failedAt           DateTime?
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  revisions BootstrapRevision[]

  @@index([workspaceId])
  @@index([status])
  @@index([stage])
  @@index([abandonedAt])
  @@map("bootstrap_sessions")
}

model BootstrapRevision {
  id               String   @id @default(uuid())
  revisionId       String   @unique
  sessionId        String
  stage            String   // which stage this revision represents
  authorInput      Json?    // author's raw input for this round
  structuredDraft  Json?    // parsed/structured version per stage
  importMapping    Json?    // for import stages: file → artifact kind mapping
  diagnostics      Json?    // validation errors/warnings
  createdAt        DateTime @default(now())
  expiresAt        DateTime // 30 days from creation for cleanup

  session  BootstrapSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  evidence BootstrapEvidence[]

  @@index([sessionId])
  @@index([stage])
  @@index([expiresAt])
  @@map("bootstrap_revisions")
}

model BootstrapEvidence {
  id              String   @id @default(uuid())
  evidenceId      String   @unique
  revisionId      String
  url             String
  title           String
  collectedAt     DateTime @default(now())
  cleanedSummary  String?  // sanitized excerpt free of copyrighted content
  licenseScope    String   // permissive, attribution-required, restricted, copyrighted
  copyrightBoundary String
  status          String
  createdAt       DateTime @default(now())

  revision BootstrapRevision @relation(fields: [revisionId], references: [revisionId], onDelete: Cascade)

  @@index([revisionId])
  @@index([url])
  @@map("bootstrap_evidence")
}
