  "main": "index.js",
  "scripts": {
    "dev": "pnpm dev:services & service_pid=$!; pnpm dev:web; web_exit=$?; kill $service_pid 2>/dev/null; wait $service_pid 2>/dev/null; exit $web_exit",
    "dev:services": "bun run packages/services/src/runtime/server.ts",
    "build:web": "webpack --config packages/web/webpack.config.mjs",
    "dev:web": "pnpm build:web && bun run packages/web/src/server.ts",
    "start:web": "pnpm build:web && bun run packages/web/src/server.ts",
    "start": "pnpm dev",
    "cli": "bun run packages/services/src/runtime/cli.ts",
    "test": "NODE_ENV=test bun test packages",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
